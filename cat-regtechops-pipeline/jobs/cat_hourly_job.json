{
  "name": "cat-regtechops-hourly-sftp-ingestion-reconciliation",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "job_clusters": [
    {
      "job_cluster_key": "cat_regtechops_job_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER",
        "spark_conf": {
          "spark.databricks.delta.schema.autoMerge.enabled": "true"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "00_sftp_pull",
      "description": "Discover and land new CAT SFTP files only.",
      "job_cluster_key": "cat_regtechops_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/regtech/cat-regtechops-pipeline/notebooks/00_sftp_pull",
        "base_parameters": {
          "sftp_host": "transfer.s3.com",
          "sftp_directory": "/cat",
          "sftp_username": "93007",
          "secret_scope": "regtech_ops_stg",
          "ssh_key_secret_key": "TR-S3-CAT-SSHKey",
          "landing_root": "abfss://analysis@stgdpdlwe.dfs.core.windows.net/BI_OUTPUT/RegTechOps/_landing/cat",
          "max_files_per_run": "500"
        }
      },
      "libraries": [
        {
          "pypi": {
            "package": "paramiko"
          }
        }
      ],
      "timeout_seconds": 1800
    },
    {
      "task_key": "01_parse_files",
      "description": "Parse landed CAT files and load the CAT error dictionary.",
      "depends_on": [
        {
          "task_key": "00_sftp_pull"
        }
      ],
      "job_cluster_key": "cat_regtechops_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/regtech/cat-regtechops-pipeline/notebooks/01_parse_files",
        "base_parameters": {
          "error_dictionary_path": "abfss://analysis@stgdpdlwe.dfs.core.windows.net/BI_OUTPUT/RegTechOps/_config/cat_error_dictionary_full_v4_1_0.json",
          "reload_error_dictionary": "false",
          "max_files_per_run": "500"
        }
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "02_enrich_errors",
      "description": "Enrich rejected records and reconcile accepted/rejected status.",
      "depends_on": [
        {
          "task_key": "01_parse_files"
        }
      ],
      "job_cluster_key": "cat_regtechops_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/regtech/cat-regtechops-pipeline/notebooks/02_enrich_errors"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "03_monitoring",
      "description": "Publish operational summaries and optional quality gates.",
      "depends_on": [
        {
          "task_key": "02_enrich_errors"
        }
      ],
      "job_cluster_key": "cat_regtechops_job_cluster",
      "notebook_task": {
        "notebook_path": "/Repos/regtech/cat-regtechops-pipeline/notebooks/03_monitoring",
        "base_parameters": {
          "fail_on_failed_files": "false",
          "fail_on_unknown_error_codes": "false"
        }
      },
      "timeout_seconds": 900
    }
  ],
  "tags": {
    "regulation": "CAT",
    "owner": "RegTechOps",
    "environment": "stg"
  }
}
